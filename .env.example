# Copia este archivo a .env y completa lo que necesites
ANTHROPIC_API_KEY=            # sin esto, los agentes trabajan sólo con reglas
VEEDOR_FUENTE=secop           # secop (datos reales) | demo (datos sintéticos)
SECOP_DEPARTAMENTO=Bolívar
SECOP_APP_TOKEN=              # opcional: https://www.datos.gov.co/profile/edit/developer_settings
VEEDOR_MODELO=claude-opus-5-5
INT_RECOLECTOR=60             # segundos entre ciclos de cada agente
INT_AUDITOR=10
INT_INVESTIGADOR=45
INT_REDACTOR=30
UMBRAL_ALERTA=60
BOLETIN_CADA_MIN=30
